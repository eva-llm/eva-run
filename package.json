  "types": "dst/server.d.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "/dst"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "husky",
    "server": "node dst/server.js",
    "worker": "node dst/control/ch.js",
    "ch": "pnpm run server & pnpm run worker",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 delete ecosystem.config.js",
    "logs": "pm2 logs",
    "monit": "pm2 monit",
    "example": "node scripts/example.js",
    "test": "jest",
    "lint": "eslint src",
    "test:coverage": "jest --coverage"
  },
